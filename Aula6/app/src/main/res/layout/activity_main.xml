<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp">

    <!-- Título -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Conversor de Moedas"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="25dp" />

    <!-- Bandeiras -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp">

        <!-- Bandeira da origem -->

        <ImageView
            android:id="@+id/ivBandeiraOrigem"
            android:layout_width="80dp"
            android:layout_height="60dp"
            android:src="@drawable/bandeira_brasil"
            android:background="@drawable/borda"
            android:padding="5dp"
            android:contentDescription="Bandeira da moeda de origem" />

        <!-- Botão de inversão -->

        <Button
            android:id="@+id/btnInverter"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:text="⇄"
            android:textSize="25sp" />

        <!-- Bandeira do destino -->

        <ImageView
            android:id="@+id/ivBandeiraDestino"
            android:layout_width="80dp"
            android:layout_height="60dp"
            android:src="@drawable/bandeira_eua"
            android:background="@drawable/borda"
            android:padding="5dp"
            android:contentDescription="Bandeira da moeda de destino" />

    </LinearLayout>

    <!-- Moeda de origem -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Moeda de origem"
        android:textSize="18sp" />

    <Spinner
        android:id="@+id/spOrigem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp" />

    <!-- Moeda de destino -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Moeda de destino"
        android:textSize="18sp" />

    <Spinner
        android:id="@+id/spDestino"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp" />

    <!-- Valor -->

    <EditText
        android:id="@+id/etValor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Digite o valor"
        android:inputType="numberDecimal"
        android:layout_marginBottom="10dp" />

    <!-- Calcular -->

    <Button
        android:id="@+id/btnCalcular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calcular" />

    <!-- Limpar -->

    <Button
        android:id="@+id/btnLimpar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Limpar" />

    <!-- Resultado -->

    <TextView
        android:id="@+id/tvResultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="20dp" />

</LinearLayout>
